// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum SubjectType {
  THEORY
  LAB
  TUTORIAL
  WORKSHOP
  PRACTICAL
  SEMINAR
  PROJECT
}

enum LectureType {
  THEORY
  LAB
  TUTORIAL
  WORKSHOP
  PRACTICAL
  SEMINAR
  PROJECT
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CANCELLED
  HOLIDAY
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id    String  @id @default(cuid())
  name  String
  email String? @unique

  // Google Classroom OAuth Creds
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  googleClassroomUserId String?
  googleEmail           String?

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// SEMESTER
//////////////////////////////////////////////////////

model Semester {
  id String @id @default(cuid())

  name         String
  academicYear String

  startDate DateTime
  endDate   DateTime

  attendanceRequirement Int @default(75)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subjects Subject[]
  holidays Holiday[]
  faculties Faculty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// SUBJECT
//////////////////////////////////////////////////////

model Subject {
  id String @id @default(cuid())

  code String @unique

  name String

  type SubjectType

  credits Int?
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  difficulty String?
  color     String?
  subjectPriority Int?

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  lectures Lecture[]

  attendanceRecords Attendance[]
  assignments       Assignment[]
  mappings          GoogleCourseMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//////////////////////////////////////////////////////
// LECTURE
//////////////////////////////////////////////////////

model Lecture {
  id String @id @default(cuid())

  dayOfWeek Day

  startTime String

  endTime String

  lectureType LectureType

  room String?

  repeatWeekly Boolean @default(true)
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  attendance Attendance[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ATTENDANCE
//////////////////////////////////////////////////////

model Attendance {
  id String @id @default(cuid())

  lectureDate DateTime

  status AttendanceStatus

  remarks String?

  lectureId String

  lecture Lecture @relation(fields: [lectureId], references: [id])

  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// HOLIDAY
//////////////////////////////////////////////////////

model Holiday {
  id String @id @default(cuid())

  title String

  date DateTime

  description String?

  semesterId String

  semester Semester @relation(fields: [semesterId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// FACULTY
//////////////////////////////////////////////////////

model Faculty {
  id          String   @id @default(cuid())
  name        String
  department  String
  email       String?
  cabin       String?
  designation String?

  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  subjects    Subject[]
  lectures    Lecture[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ASSIGNMENT
//////////////////////////////////////////////////////

model Assignment {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  subjectId          String
  subject            Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source             String    // "GOOGLE" | "MANUAL"
  googleAssignmentId String?   @unique
  googleCourseId     String?
  dueDate            DateTime?
  dueTime            String?
  maxMarks           Float?
  priority           String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  status             String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "SUBMITTED" | "COMPLETED" | "MISSED" | "OVERDUE"
  submissionStatus   String?
  attachments        String?
  notes              String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// GOOGLE COURSE MAPPING
//////////////////////////////////////////////////////

model GoogleCourseMapping {
  id             String   @id @default(cuid())
  googleCourseId String   @unique
  courseName     String
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

