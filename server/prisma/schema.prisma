generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String     @id @default(cuid())
  name                  String
  email                 String?    @unique
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  googleAccessToken     String?
  googleClassroomUserId String?
  googleEmail           String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  semesters             Semester[]
}

model Semester {
  id                    String    @id @default(cuid())
  name                  String
  academicYear          String
  startDate             DateTime
  endDate               DateTime
  attendanceRequirement Int       @default(75)
  userId                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  faculties             Faculty[]
  holidays              Holiday[]
  user                  User      @relation(fields: [userId], references: [id])
  subjects              Subject[]
}

model Subject {
  id                String                @id @default(cuid())
  code              String                @unique
  name              String
  type              SubjectType
  credits           Int?
  subjectPriority   Int?
  semesterId        String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  color             String?
  difficulty        String?
  facultyId         String?
  assignments       Assignment[]
  attendanceRecords Attendance[]
  mappings          GoogleCourseMapping[]
  lectures          Lecture[]
  faculty           Faculty?              @relation(fields: [facultyId], references: [id])
  semester          Semester              @relation(fields: [semesterId], references: [id])
}

model Lecture {
  id           String       @id @default(cuid())
  dayOfWeek    Day
  startTime    String
  endTime      String
  lectureType  LectureType
  room         String?
  repeatWeekly Boolean      @default(true)
  subjectId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  facultyId    String?
  attendance   Attendance[]
  faculty      Faculty?     @relation(fields: [facultyId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
}

model Attendance {
  id          String           @id @default(cuid())
  lectureDate DateTime
  status      AttendanceStatus
  remarks     String?
  lectureId   String
  subjectId   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lecture     Lecture          @relation(fields: [lectureId], references: [id])
  subject     Subject          @relation(fields: [subjectId], references: [id])
}

model Holiday {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  semesterId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  semester    Semester @relation(fields: [semesterId], references: [id])
}

model Faculty {
  id          String    @id @default(cuid())
  name        String
  department  String
  email       String?
  cabin       String?
  designation String?
  semesterId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  semester    Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  lectures    Lecture[]
  subjects    Subject[]
}

model Assignment {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  subjectId          String
  source             String
  googleAssignmentId String?   @unique
  googleCourseId     String?
  dueDate            DateTime?
  dueTime            String?
  maxMarks           Float?
  priority           String    @default("MEDIUM")
  status             String    @default("PENDING")
  submissionStatus   String?
  attachments        String?
  notes              String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  subject            Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model GoogleCourseMapping {
  id             String   @id @default(cuid())
  googleCourseId String   @unique
  courseName     String
  subjectId      String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

enum SubjectType {
  THEORY
  LAB
  TUTORIAL
  WORKSHOP
  PRACTICAL
  SEMINAR
  PROJECT
}

enum LectureType {
  THEORY
  LAB
  TUTORIAL
  WORKSHOP
  PRACTICAL
  SEMINAR
  PROJECT
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CANCELLED
  HOLIDAY
}
